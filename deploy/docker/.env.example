# Projecty Docker 部署环境变量示例
# 复制为同目录下的 .env 后替换所有占位值;JWT_SECRET 建议用 openssl rand -hex 32 生成。

# PostgreSQL
POSTGRES_DB=projecty
POSTGRES_USER=projecty
POSTGRES_PASSWORD=change-me

# 鉴权(JWT_SECRET 必填)
JWT_SECRET=change-me-to-a-long-random-string

# 宿主机端口(前后端合并为单镜像,共用一个入口端口)
PROJECTY_BACKEND_PORT=28080
