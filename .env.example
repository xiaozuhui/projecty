# API
PROJECTY_ENV=development
PROJECTY_BIND_HOST=127.0.0.1
PROJECTY_BIND_PORT=8080
# 本地开发时请替换 USERNAME、PASSWORD 和主机地址
DATABASE_URL=postgres://USERNAME:PASSWORD@127.0.0.1:5432/projecty
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=projecty
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600
# 任务附件(图片)本地磁盘存储
PROJECTY_UPLOAD_DIR=uploads
PROJECTY_UPLOAD_MAX_BYTES=10485760

# Web
# 浏览器侧 API 走同源相对路径，由前端容器代理转发到后端容器（无需感知后端端口）
PUBLIC_API_BASE_URL=/api/v1
# 前端容器代理上游：同一 compose 网络内用服务名解析
INTERNAL_API_ORIGIN=http://backend:8080

# Docker Compose
POSTGRES_DB=projecty
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-db-password
PROJECTY_BACKEND_PORT=28081
PROJECTY_FRONTEND_PORT=28080
